[flake8]
# Black 호환 설정
max-line-length = 88
extend-ignore = E203, W503, E501
# E203: black과 충돌 (whitespace before ':')
# W503: black과 충돌 (line break before binary operator)
# E501: line too long (black이 처리함)

# 제외할 디렉토리
exclude =
    .git,
    __pycache__,
    */migrations/*,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    .tox

# 파일당 최대 복잡도
max-complexity = 10

# Django 관련 설정
# Django 모델의 Meta 클래스에서 ordering 사용 허용
per-file-ignores =
    # __init__.py 파일에서는 import만 하고 사용 안 해도 됨
    __init__.py:F401
    # settings.py에서는 줄이 길어질 수 있음
    */settings.py:E501
