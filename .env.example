# Django 설정
# 프로덕션 환경에서는 반드시 False로 설정하세요
DEBUG=True

# Django Secret Key
# 프로덕션 환경에서는 반드시 새로운 키를 생성하세요
# 생성 방법: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production

# 허용할 호스트 (쉼표로 구분)
# 프로덕션: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# 데이터베이스 설정
# SQLite 사용시 (기본값)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL 사용시 (예시)
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# MySQL 사용시 (예시)
# DATABASE_URL=mysql://username:password@localhost:3306/dbname

# CORS 설정 (프론트엔드 URL, 쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 이메일 설정 (선택사항)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# AWS S3 설정 (미디어 파일 저장용, 선택사항)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=ap-northeast-2

# Redis 설정 (캐싱/세션용, 선택사항)
# REDIS_URL=redis://localhost:6379/0

# Sentry 설정 (에러 트래킹, 선택사항)
# SENTRY_DSN=your-sentry-dsn-here

# 기타 외부 API 키 (필요시 추가)
# EXTERNAL_API_KEY=your-api-key-here
